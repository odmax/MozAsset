# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/asset_management?schema=public"

# ===========================================
# AUTHENTICATION
# ===========================================
# For local development: http://localhost:3000
# For Vercel Preview: https://[your-project]-vercel-preview-url.vercel.app
# For Vercel Production: https://[your-production-domain].com
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# ===========================================
# EMAIL PROVIDER
# Options: console (dev only), smtp, resend, brevo
# ===========================================
EMAIL_PROVIDER=console

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Email sender (all providers)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=MozAssets

# ===========================================
# PAYFAST (Payment Gateway)
# ===========================================
# Mode: sandbox or live
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase

# URLs (use preview/production URLs in Vercel)
# Sandbox: https://[your-project]-vercel-preview-url.vercel.app
# Production: https://[your-production-domain].com
PAYFAST_ITN_URL=http://localhost:3000/api/payfast/itn
PAYFAST_RETURN_URL=http://localhost:3000/checkout/success
PAYFAST_CANCEL_URL=http://localhost:3000/checkout/cancel

# ===========================================
# FILE STORAGE (Cloudinary)
# ===========================================
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# DATABASE BACKUPS
# ===========================================
# Storage backend: local, s3, or backblaze
BACKUP_STORAGE=local
# Local backup directory (default: ./backups)
BACKUP_LOCAL_DIR=./backups
# Retention period in days (default: 30)
BACKUP_RETENTION_DAYS=30
# Email to notify on backup failure (requires SMTP config)
BACKUP_NOTIFICATION_EMAIL=

# S3 Configuration (when BACKUP_STORAGE=s3)
BACKUP_S3_BUCKET=mozassets-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Backblaze B2 Configuration (when BACKUP_STORAGE=backblaze)
BACKUP_B2_BUCKET=mozassets-backups
BACKUP_B2_REGION=us-west-004
BACKUP_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKUP_B2_ACCESS_KEY=
BACKUP_B2_SECRET_KEY=

# ===========================================
# BACKGROUND JOBS (Upstash Redis)
# ===========================================
# Get these from https://console.upstash.com
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token

# Queue worker secret (used to secure the /api/queue/process endpoint)
QUEUE_SECRET=your-queue-secret-change-in-production