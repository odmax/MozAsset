generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ASSET_MANAGER
  DEPARTMENT_MANAGER
  EMPLOYEE
}

enum AppearanceMode {
  LIGHT
  DARK
  SYSTEM
}

enum InternalRole {
  OWNER
  SUPER_ADMIN
  SUPPORT_MANAGER
  SUPPORT_AGENT
  FINANCE_ADMIN
  VIEWER
}

enum AgentStatus {
  ONLINE
  BUSY
  AWAY
  OFFLINE
  IN_MEETING
  BREAK
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SenderType {
  USER
  BOT
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum FileType {
  ASSET_IMAGE
  INVOICE
  WARRANTY_DOC
  MAINTENANCE_RECEIPT
  MANUAL
  SUPPORT_ATTACHMENT
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
  TRIALING
}

enum BillingProvider {
  STRIPE
  PAYSTACK
  NONE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
  DISPOSED
  LOST
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  NEEDS_REPAIR
}

enum NotificationType {
  ASSET_ASSIGNED
  ASSET_TRANSFERRED
  MAINTENANCE_DUE
  MAINTENANCE_COMPLETED
  SUPPORT_REPLY
  BILLING_SUCCESSFUL
  BILLING_FAILED
  SUBSCRIPTION_CANCELLED
  PLAN_UPGRADED
  USER_INVITED
  EXPORT_COMPLETED
  ORGANIZATION_UPDATE
  TICKET_ASSIGNED
  TICKET_ESCALATED
  SLA_BREACH_WARNING
  AGENT_REPLY
  ACCOUNT_INACTIVE
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETION_WARNING
  ACCOUNT_REACTIVATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  TRANSFER
  CHECK_IN
  CHECK_OUT
  MAINTENANCE
  RETIRE
  DISPOSE
  ACTIVATE
  DEACTIVATE
  PASSWORD_RESET
  LOGIN_FAILED
  LOGIN_SUCCESS
  LOGOUT
  SECURITY_ALERT
  CSRF_VIOLATION
  RATE_LIMIT_HIT
  UNAUTHORIZED_ACCESS
  TICKET_ASSIGNED
  TICKET_TRANSFERRED
  TICKET_ESCALATED
  AGENT_STATUS_CHANGED
  PERMISSION_CHANGED
  INTERNAL_NOTE_ADDED
  TICKET_PRIORITY_CHANGED
  VERIFICATION_EMAIL_SENT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role      @default(EMPLOYEE)
  plan            Plan      @default(FREE)
  assetLimit      Int       @default(50)
  departmentLimit Int       @default(1)
  locationLimit   Int       @default(1)
  userLimit       Int       @default(3)
  onBoardingComplete Boolean @default(false)
  
  subscriptionStatus   SubscriptionStatus @default(ACTIVE)
  billingProvider      BillingProvider    @default(NONE)
  billingCustomerId    String?
  billingSubscriptionId String?
  billingPeriodStart   DateTime?
  billingPeriodEnd     DateTime?
  canceledAt           DateTime?
  lastPaymentAt       DateTime?
  
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  isActive        Boolean   @default(true)
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  resetToken      String?
  resetTokenExpiry DateTime?
  emailVerificationToken String?
  verificationTokenExpiry DateTime?
  emailVerifiedAt DateTime?
  
  appearanceMode  AppearanceMode @default(SYSTEM)
  themeColor     String?        @default("#222222")
  companyLogoUrl String?

  emailMarketing    Boolean @default(true)
  emailSecurity     Boolean @default(true)
  emailSupport      Boolean @default(true)
  emailMaintenance  Boolean @default(true)
  emailBilling      Boolean @default(true)

  // Inactivity lifecycle (FREE accounts only)
  lastActiveAt          DateTime?
  isDeactivated         Boolean   @default(false)
  deactivatedAt         DateTime?
  scheduledDeletionAt   DateTime?
  deactivationReason    String?
  inactivityWarningSentAt   DateTime?
  finalWarningSentAt        DateTime?

  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  ownedOrganization Organization? @relation("OrganizationOwner")

  accounts        Account[]
  sessions        Session[]
  assets          Asset[]          @relation("AssignedAssets")
  assignedAssets  AssetAssignment[]
  auditLogs       AuditLog[]
  maintenances    Maintenance[]
  managedDepartments Department[] @relation("DepartmentManager")
  invoices        Invoice[]
  payments       Payment[]
  supportTickets SupportTicket[]
  files          File[]         @relation("FileUploader")
  notifications  Notification[]

  @@index([email])
  @@index([departmentId])
  @@index([organizationId])
}

model Organization {
  id              String    @id @default(cuid())
  name            String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerId         String    @unique
  owner           User       @relation("OrganizationOwner", fields: [ownerId], references: [id])

  users           User[]
  departments     Department[]
  locations       Location[]
  assets          Asset[]
  categories      Category[]
  vendors         Vendor[]
  files           File[]

  // General
  description     String?
  industry        String?
  companySize     String?

  // Contact
  orgEmail        String?
  phone           String?
  alternatePhone  String?
  website         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  province        String?
  postalCode      String?
  country         String?

  // Branding
  logo            String?
  favicon         String?
  primaryColor    String    @default("#3b82f6")
  secondaryColor  String    @default("#6366f1")

  // Preferences
  timezone        String    @default("Africa/Johannesburg")
  dateFormat      String    @default("DD/MM/YYYY")
  currency        String    @default("ZAR")
  defaultLanguage String    @default("en")

  // Billing
  plan            Plan      @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  billingProvider BillingProvider @default(NONE)
  billingCustomerId String?
  billingSubscriptionId String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  canceledAt       DateTime?

  @@index([ownerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assets      Asset[]

  @@unique([name, organizationId])
  @@index([name])
  @@index([organizationId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  managerId   String?
  manager     User?    @relation("DepartmentManager", fields: [managerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  users       User[]
  locations   Location[]
  assets      Asset[]

  @@index([name])
  @@index([code])
  @@index([organizationId])
}

model Location {
  id           String     @id @default(cuid())
  name         String
  address      String?
  building     String?
  floor        String?
  room         String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assets       Asset[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([organizationId])
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assets      Asset[]

  @@unique([name, organizationId])
  @@index([name])
  @@index([organizationId])
}

model Asset {
  id              String         @id @default(cuid())
  assetTag        String         @unique
  name            String
  description     String?
  serialNumber    String?
  model           String?
  brand           String?
  status          AssetStatus    @default(AVAILABLE)
  condition       AssetCondition @default(GOOD)
  
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  
  locationId      String?
  location        Location?      @relation(fields: [locationId], references: [id])
  
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  
  assignedToId    String?
  assignedTo      User?          @relation("AssignedAssets", fields: [assignedToId], references: [id])
  
  vendorId        String?
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  
  purchaseDate    DateTime?
  purchaseCost    Decimal?      @db.Decimal(12, 2)
  warrantyExpiry  DateTime?
  notes           String?       @db.Text
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignments     AssetAssignment[]
  transfers       AssetTransfer[]
  maintenances    Maintenance[]
  checkIns        CheckInOut[]
  auditLogs       AuditLog[]
  files           File[]

  @@index([assetTag])
  @@index([name])
  @@index([status])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assignedToId])
}

model AssetAssignment {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  assignedBy  String
  assignedAt  DateTime  @default(now())
  returnedAt  DateTime?
  notes       String?   @db.Text

  @@index([assetId])
  @@index([userId])
}

model AssetTransfer {
  id              String   @id @default(cuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromDepartmentId String?
  toDepartmentId   String
  fromLocationId   String?
  toLocationId     String?
  fromUserId       String?
  toUserId         String?
  transferredBy    String
  transferredAt    DateTime @default(now())
  notes           String?   @db.Text

  @@index([assetId])
}

model Maintenance {
  id            String          @id @default(cuid())
  assetId       String
  asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type          String
  description   String          @db.Text
  performedBy   String
  performedByUser User          @relation(fields: [performedBy], references: [id])
  performedAt   DateTime        @default(now())
  cost          Decimal?        @db.Decimal(10, 2)
  vendorId      String?
  nextDueDate   DateTime?
  status        String          @default("COMPLETED")
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  files         File[]

  @@index([assetId])
  @@index([performedBy])
}

model CheckInOut {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId      String
  type        String    // CHECK_IN or CHECK_OUT
  checkedAt   DateTime  @default(now())
  notes       String?   @db.Text
  condition   AssetCondition?
  createdAt   DateTime  @default(now())

  @@index([assetId])
  @@index([userId])
}

model File {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  uploadedById    String
  uploadedBy      User          @relation("FileUploader", fields: [uploadedById], references: [id])
  assetId         String?
  asset           Asset?        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceId   String?
  maintenance     Maintenance?  @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  supportTicketId String?
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  type            FileType      @default(OTHER)
  fileName        String
  originalName    String
  mimeType        String
  size            Int
  url             String
  thumbnailUrl    String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([organizationId])
  @@index([uploadedById])
  @@index([assetId])
  @@index([maintenanceId])
  @@index([supportTicketId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String
  assetId     String?
  asset       Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  changes     Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([assetId])
  @@index([userId])
  @@index([createdAt])
}

model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  type       String?
  status     String   // sent, failed
  error      String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([to])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String?
  organizationId String?
  type           NotificationType
  title          String
  message        String           @db.Text
  link           String?
  isRead         Boolean          @default(false)
  priority       String           @default("normal")
  actorId        String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  adminId        String?
  admin          InternalAdmin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([adminId, isRead])
  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  company    String?
  phone      String?
  message    String   @db.Text
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal   @db.Decimal(10, 2)
  currency    String   @default("USD")
  status      String   @default("PENDING")
  provider    BillingProvider @default(NONE)
  providerInvoiceId String?
  description String?
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal   @db.Decimal(10, 2)
  currency  String   @default("ZAR")
  status    String   @default("PENDING")
  provider  String   @default("NONE")
  providerPaymentId String?
  plan      String?
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([createdAt])
}

model InternalAdmin {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  password  String
  role      InternalRole  @default(SUPPORT_AGENT)
  isActive  Boolean       @default(true)
  lastLogin DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Agent management fields
  avatar            String?
  status            AgentStatus  @default(OFFLINE)
  isOnline          Boolean      @default(false)
  isBusy            Boolean      @default(false)
  maxConcurrentChats Int         @default(5)
  activeChatCount   Int          @default(0)
  lastActiveAt      DateTime?
  statusMessage     String?
  assignedDepartments String?
  isSuspended       Boolean      @default(false)
  createdByOwner    Boolean      @default(false)
  permissions       Json?

  assignedTickets SupportTicket[]
  internalNotes   InternalNote[]
  escalatedTickets SupportTicket[] @relation("EscalatedTickets")
  notifications   Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model SupportTicket {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  organizationId  String?
  subject        String
  category       String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  assignedAdminId String?
  assignedAdmin  InternalAdmin? @relation(fields: [assignedAdminId], references: [id])

  // Transfer & escalation
  escalatedToId  String?
  escalatedTo    InternalAdmin? @relation("EscalatedTickets", fields: [escalatedToId], references: [id])
  escalatedAt    DateTime?
  escalatedBy    String?
  escalationReason String?
  transferredFromId String?
  transferredAt   DateTime?
  transferredBy   String?
  transferNote   String?

  // SLA tracking
  slaDeadline    DateTime?
  slaBreachedAt  DateTime?
  firstResponseAt DateTime?
  resolvedAt     DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages       SupportMessage[]
  files          File[]
  internalNotes  InternalNote[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([assignedAdminId])
  @@index([escalatedToId])
  @@index([priority])
  @@index([slaDeadline])
  @@index([createdAt])
}

model SupportMessage {
  id           String     @id @default(cuid())
  ticketId     String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  senderType  SenderType @default(USER)
  senderUserId String?
  senderAdminId String?
  message     String     @db.Text
  createdAt   DateTime   @default(now())
  readAt      DateTime?

  @@index([ticketId])
  @@index([senderUserId])
  @@index([senderAdminId])
}

model InternalNote {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    InternalAdmin @relation(fields: [authorId], references: [id])
  content   String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([ticketId])
  @@index([authorId])
}

model SlaRule {
  id              String          @id @default(cuid())
  priority        TicketPriority  @unique
  responseTimeMin Int
  resolutionTimeMin Int
  breachPenalty   String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([priority])
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum BackupStorageBackend {
  LOCAL
  S3
  BACKBLAZE
}

model Backup {
  id              String              @id @default(cuid())
  status          BackupStatus        @default(PENDING)
  storageBackend  BackupStorageBackend @default(LOCAL)
  filePath        String?
  fileSize        BigInt?
  md5Hash         String?
  errorMessage    String?
  triggeredBy     String?
  notes           String?
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
}
