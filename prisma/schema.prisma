generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ASSET_MANAGER
  DEPARTMENT_MANAGER
  EMPLOYEE
}

enum AppearanceMode {
  LIGHT
  DARK
  SYSTEM
}

enum InternalRole {
  OWNER
  PLATFORM_ADMIN
  SUPER_ADMIN
  SUPPORT_MANAGER
  ACCOUNT_MANAGER
  SUPPORT_AGENT
  FINANCE_ADMIN
  VIEWER
}

enum AgentStatus {
  ONLINE
  BUSY
  AWAY
  OFFLINE
  IN_MEETING
  BREAK
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SenderType {
  USER
  BOT
  ADMIN
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  SEEN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum FileType {
  ASSET_IMAGE
  INVOICE
  WARRANTY_DOC
  MAINTENANCE_RECEIPT
  MANUAL
  SUPPORT_ATTACHMENT
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELED
  PAUSED
  TRIALING
}

enum BillingProvider {
  STRIPE
  PAYSTACK
  PAYFAST
  NONE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
  DISPOSED
  LOST
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  NEEDS_REPAIR
}

enum NotificationType {
  ASSET_ASSIGNED
  ASSET_TRANSFERRED
  MAINTENANCE_DUE
  MAINTENANCE_COMPLETED
  SUPPORT_REPLY
  BILLING_SUCCESSFUL
  BILLING_FAILED
  SUBSCRIPTION_CANCELLED
  PLAN_UPGRADED
  USER_INVITED
  EXPORT_COMPLETED
  ORGANIZATION_UPDATE
  TICKET_ASSIGNED
  TICKET_ESCALATED
  SLA_BREACH_WARNING
  AGENT_REPLY
  ACCOUNT_INACTIVE
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETION_WARNING
  ACCOUNT_REACTIVATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  TRANSFER
  CHECK_IN
  CHECK_OUT
  MAINTENANCE
  RETIRE
  DISPOSE
  ACTIVATE
  DEACTIVATE
  PASSWORD_RESET
  LOGIN_FAILED
  LOGIN_SUCCESS
  LOGOUT
  SECURITY_ALERT
  CSRF_VIOLATION
  RATE_LIMIT_HIT
  UNAUTHORIZED_ACCESS
  TICKET_ASSIGNED
  TICKET_TRANSFERRED
  TICKET_ESCALATED
  AGENT_STATUS_CHANGED
  PERMISSION_CHANGED
  INTERNAL_NOTE_ADDED
  TICKET_PRIORITY_CHANGED
  TICKET_RESOLVED
  VERIFICATION_EMAIL_SENT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               Role      @default(EMPLOYEE)
  plan               Plan      @default(FREE)
  assetLimit         Int       @default(50)
  departmentLimit    Int       @default(1)
  locationLimit      Int       @default(1)
  userLimit          Int       @default(3)
  onBoardingComplete Boolean   @default(false)

  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  billingProvider       BillingProvider    @default(NONE)
  billingCustomerId     String?
  billingSubscriptionId String?
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  canceledAt            DateTime?
  lastPaymentAt         DateTime?
  gracePeriodEnd        DateTime?
  renewalReminderSentAt DateTime?

  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  isActive        Boolean     @default(true)
  isPlatformAdmin Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  resetToken              String?
  resetTokenExpiry        DateTime?
  emailVerificationToken  String?
  verificationTokenExpiry DateTime?
  emailVerifiedAt         DateTime?

  appearanceMode AppearanceMode @default(SYSTEM)
  themeColor     String?        @default("#222222")
  companyLogoUrl String?

  emailMarketing   Boolean @default(true)
  emailSecurity    Boolean @default(true)
  emailSupport     Boolean @default(true)
  emailMaintenance Boolean @default(true)
  emailBilling     Boolean @default(true)

  // Inactivity lifecycle (FREE accounts only)
  lastActiveAt            DateTime?
  isDeactivated           Boolean   @default(false)
  deactivatedAt           DateTime?
  scheduledDeletionAt     DateTime?
  deactivationReason      String?
  inactivityWarningSentAt DateTime?
  finalWarningSentAt      DateTime?

  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  ownedOrganization Organization? @relation("OrganizationOwner")

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  accounts           Account[]
  sessions           Session[]
  assets             Asset[]           @relation("AssignedAssets")
  assignedAssets     AssetAssignment[]
  auditLogs          AuditLog[]
  maintenances       Maintenance[]
  managedDepartments Department[]      @relation("DepartmentManager")
  invoices           Invoice[]
  payments           Payment[]
  supportTickets     SupportTicket[]
  files              File[]            @relation("FileUploader")
  notifications      Notification[]
  ApiKey             ApiKey[]
  upgradeRequests    UpgradeRequest[]
  engagementEmails   UserEngagementEmail[]
  purchaseRequests   PurchaseRequest[]   @relation("PurchaseRequester")
  approvedRequests   PurchaseRequest[]   @relation("PurchaseApprover")
  createdOrders      PurchaseOrder[]     @relation("POCreator")
  approvedOrders     PurchaseOrder[]     @relation("POApprover")
  stockSessions      StockVerificationSession[]
  stockVerifications StockVerificationItem[]
  approvalRequests   ApprovalRequest[] @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecider")

  @@index([email])
  @@index([departmentId])
  @@index([organizationId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String @unique
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  users       User[]
  departments Department[]
  locations   Location[]
  assets      Asset[]
  categories  Category[]
  vendors     Vendor[]
  files       File[]

  // General
  description String?
  industry    String?
  companySize String?

  // Contact
  orgEmail       String?
  phone          String?
  alternatePhone String?
  website        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  province       String?
  postalCode     String?
  country        String?

  // Branding
  logo           String?
  favicon        String?
  reportLogoUrl  String?
  primaryColor   String  @default("#3b82f6")
  secondaryColor String  @default("#6366f1")
  brandName      String?

  // Preferences
  timezone        String @default("Africa/Johannesburg")
  dateFormat      String @default("DD/MM/YYYY")
  currency        String @default("ZAR")
  defaultLanguage String @default("en")

  approvalEnabled          Boolean @default(false)
  approvalRequiredActions  Json?   // e.g. ["ASSIGNMENT","TRANSFER","RETIREMENT","DELETION","MAINTENANCE"]
  approvalDefaultApprovers Json?   // e.g. ["userId1","userId2"]

  accountManagerId      String?
  accountManager        InternalAdmin? @relation("OrgAccountManager", fields: [accountManagerId], references: [id])
  slaEnabled            Boolean @default(false)
  slaFirstResponseMin   Int     @default(60)
  slaResolutionHours    Int     @default(24)

  // Billing
  plan                  Plan               @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  billingProvider       BillingProvider    @default(NONE)
  billingCustomerId     String?
  billingSubscriptionId String?
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  canceledAt            DateTime?

  branches            Branch[]
  apiKeys             ApiKey[]
  depreciationRecords DepreciationRecord[]
  stockSessions       StockVerificationSession[]
  approvalRequests    ApprovalRequest[]
  purchaseRequests    PurchaseRequest[]
  purchaseOrders      PurchaseOrder[]

  @@index([ownerId])
}

model Branch {
  id       String  @id @default(cuid())
  name     String
  code     String?
  address  String?
  city     String?
  province String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  assets      Asset[]
  users       User[]
  departments Department[]
  locations   Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([code])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  prefix      String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  permissions Json?
  usageCount  Int       @default(0)
  rateLimit   Int       @default(100)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([key])
  @@index([prefix])
}

model StockVerificationSession {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?
  departmentId   String?
  locationId     String?
  status         String   @default("DRAFT")
  startedAt      DateTime?
  completedAt    DateTime?
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  items          StockVerificationItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model ApprovalRequest {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  requestedById  String
  requestedBy    User     @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approverId     String?
  approver       User?    @relation("ApprovalDecider", fields: [approverId], references: [id])
  type           String   // ASSIGNMENT, TRANSFER, RETIREMENT, DELETION, MAINTENANCE
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  targetType     String   // Asset, Maintenance, etc.
  targetId       String
  reason         String?
  notes          String?
  requestedAt    DateTime @default(now())
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([requestedById])
  @@index([approverId])
}

model StockVerificationItem {
  id               String    @id @default(cuid())
  sessionId        String
  session          StockVerificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset     @relation(fields: [assetId], references: [id])
  expectedLocation String?
  verifiedLocation String?
  expectedUser     String?
  verifiedUser     String?
  status           String    @default("PENDING")
  notes            String?
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?     @relation(fields: [verifiedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([sessionId])
  @@index([assetId])
}

model DepreciationRecord {
  id                    String        @id @default(cuid())
  assetId               String
  asset                 Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  organizationId        String?
  organization          Organization? @relation(fields: [organizationId], references: [id])
  method                DepreciationMethod @default(STRAIGHT_LINE)
  amount                Decimal?      @db.Decimal(12, 2)
  bookValueBefore       Decimal?      @db.Decimal(12, 2)
  bookValueAfter        Decimal?      @db.Decimal(12, 2)
  accumulatedDep        Decimal?      @db.Decimal(12, 2)
  periodDate            DateTime?
  notes                 String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([assetId])
  @@index([organizationId])
  @@index([periodDate])
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assets Asset[]

  @@unique([name, organizationId])
  @@index([name])
  @@index([organizationId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  managerId   String?
  manager     User?    @relation("DepartmentManager", fields: [managerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  users     User[]
  locations Location[]
  assets    Asset[]

  @@index([name])
  @@index([code])
  @@index([organizationId])
  @@index([branchId])
}

model Location {
  id           String      @id @default(cuid())
  name         String
  address      String?
  building     String?
  floor        String?
  room         String?
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assets Asset[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([organizationId])
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assets Asset[]
  purchaseOrders PurchaseOrder[]

  @@unique([name, organizationId])
  @@index([name])
  @@index([organizationId])
}

model Asset {
  id           String         @id @default(cuid())
  assetTag     String         @unique
  name         String
  description  String?
  serialNumber String?
  model        String?
  brand        String?
  status       AssetStatus    @default(AVAILABLE)
  condition    AssetCondition @default(GOOD)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedAssets", fields: [assignedToId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  purchaseDate   DateTime?
  purchaseCost   Decimal?  @db.Decimal(12, 2)
  warrantyExpiry DateTime?
  notes          String?   @db.Text
  poNumber       String?
  orderedDate    DateTime?
  receivedDate   DateTime?

  depreciationMethod       DepreciationMethod @default(STRAIGHT_LINE)
  depreciationStartDate    DateTime?
  depreciationEndDate      DateTime?
  usefulLifeMonths         Int       @default(60)
  salvageValue             Decimal?  @db.Decimal(12, 2)
  currentBookValue         Decimal?  @db.Decimal(12, 2)
  accumulatedDepreciation  Decimal?  @db.Decimal(12, 2) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments        AssetAssignment[]
  transfers          AssetTransfer[]
  maintenances       Maintenance[]
  checkIns           CheckInOut[]
  auditLogs          AuditLog[]
  files              File[]
  DepreciationRecord DepreciationRecord[]
  StockVerificationItem StockVerificationItem[]

  @@index([assetTag])
  @@index([name])
  @@index([status])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([branchId])
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  assignedBy String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?   @db.Text

  @@index([assetId])
  @@index([userId])
}

model AssetTransfer {
  id               String   @id @default(cuid())
  assetId          String
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromDepartmentId String?
  toDepartmentId   String
  fromLocationId   String?
  toLocationId     String?
  fromUserId       String?
  toUserId         String?
  transferredBy    String
  transferredAt    DateTime @default(now())
  notes            String?  @db.Text

  @@index([assetId])
}

model Maintenance {
  id              String    @id @default(cuid())
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type            String
  description     String    @db.Text
  performedBy     String
  performedByUser User      @relation(fields: [performedBy], references: [id])
  performedAt     DateTime  @default(now())
  cost            Decimal?  @db.Decimal(10, 2)
  vendorId        String?
  scheduledDate   DateTime?
  completedDate   DateTime?
  nextDueDate     DateTime?
  recurrence      String    @default("none")
  status          String    @default("SCHEDULED")
  notes           String?   @db.Text
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  files File[]

  @@index([assetId])
  @@index([performedBy])
}

model CheckInOut {
  id        String          @id @default(cuid())
  assetId   String
  asset     Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  type      String // CHECK_IN or CHECK_OUT
  checkedAt DateTime        @default(now())
  notes     String?         @db.Text
  condition AssetCondition?
  createdAt DateTime        @default(now())

  @@index([assetId])
  @@index([userId])
}

model File {
  id              String         @id @default(cuid())
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  uploadedById    String
  uploadedBy      User           @relation("FileUploader", fields: [uploadedById], references: [id])
  assetId         String?
  asset           Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceId   String?
  maintenance     Maintenance?   @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  supportTicketId String?
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  type            FileType       @default(OTHER)
  fileName        String
  originalName    String
  mimeType        String
  size            Int
  url             String
  thumbnailUrl    String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([uploadedById])
  @@index([assetId])
  @@index([maintenanceId])
  @@index([supportTicketId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  assetId    String?
  asset      Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  changes    Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([assetId])
  @@index([userId])
  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String?
  status    String // sent, failed
  error     String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([to])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model GoogleConversionLog {
  id            String   @id @default(cuid())
  transactionId String   @unique
  plan          String
  value         Float
  currency      String   @default("ZAR")
  sentAt        DateTime @default(now())
  status        String   @default("sent")
  error         String?

  @@index([transactionId])
  @@index([sentAt])
}

model UpgradeRequest {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  organizationId     String?
  currentPlan        String
  targetPlan         String
  amount             Float
  status             String   @default("PENDING_PAYMENT")
  paymentReference   String?  @unique
  checkoutUrl        String?
  requestedByAdminId String?
  confirmedByAdminId String?
  notes              String?
  expiresAt          DateTime
  paidAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentReference])
  @@index([expiresAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String?
  organizationId String?
  type           NotificationType
  title          String
  message        String           @db.Text
  link           String?
  isRead         Boolean          @default(false)
  priority       String           @default("normal")
  actorId        String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  adminId String?
  admin   InternalAdmin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([adminId, isRead])
  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String   @db.Text
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  status            String          @default("PENDING")
  provider          BillingProvider @default(NONE)
  providerInvoiceId String?
  description       String?
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("ZAR")
  status            String    @default("PENDING")
  provider          String    @default("NONE")
  providerPaymentId String?
  plan              String?
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([createdAt])
}

model InternalAdmin {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  password  String
  role      InternalRole @default(SUPPORT_AGENT)
  isActive  Boolean      @default(true)
  lastLogin DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Agent management fields
  avatar              String?
  status              AgentStatus @default(OFFLINE)
  isOnline            Boolean     @default(false)
  isBusy              Boolean     @default(false)
  maxConcurrentChats  Int         @default(5)
  activeChatCount     Int         @default(0)
  lastActiveAt        DateTime?
  statusMessage       String?
  assignedDepartments String?
  isSuspended         Boolean     @default(false)
  createdByOwner      Boolean     @default(false)
  permissions         Json?
  lastAssignedAt      DateTime?

  assignedTickets  SupportTicket[]
  internalNotes    InternalNote[]
  escalatedTickets SupportTicket[] @relation("EscalatedTickets")
  managedOrgs      Organization[]   @relation("OrgAccountManager")
  notifications    Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model SupportTicket {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  organizationId  String?
  subject         String
  category        String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  assignedAdminId String?
  assignedAdmin   InternalAdmin? @relation(fields: [assignedAdminId], references: [id])

  // Transfer & escalation
  escalatedToId     String?
  escalatedTo       InternalAdmin? @relation("EscalatedTickets", fields: [escalatedToId], references: [id])
  escalatedAt       DateTime?
  escalatedBy       String?
  escalationReason  String?
  transferredFromId String?
  transferredAt     DateTime?
  transferredBy     String?
  transferNote      String?

  // SLA tracking
  slaStatus       String?   // ON_TRACK, AT_RISK, BREACHED
  slaDeadline     DateTime?
  slaBreachedAt   DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Realtime chat fields
  userTypingAt    DateTime?
  adminTypingAt   DateTime?
  userLastSeenAt  DateTime?
  adminLastSeenAt DateTime?

  messages      SupportMessage[]
  files         File[]
  internalNotes InternalNote[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([assignedAdminId])
  @@index([escalatedToId])
  @@index([priority])
  @@index([slaDeadline])
  @@index([createdAt])
}

model SupportMessage {
  id              String        @id @default(cuid())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id])
  senderType      SenderType    @default(USER)
  senderUserId    String?
  senderAdminId   String?
  message         String        @db.Text
  status          MessageStatus @default(SENT)
  deliveredAt     DateTime?
  seenAt          DateTime?
  createdAt       DateTime      @default(now())
  readAt          DateTime?
  clientMessageId String?       @unique

  @@index([ticketId])
  @@index([senderUserId])
  @@index([senderAdminId])
  @@index([clientMessageId])
}

model InternalNote {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    InternalAdmin @relation(fields: [authorId], references: [id])
  content   String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([ticketId])
  @@index([authorId])
}

model UserEngagementEmail {
  id        String   @id @default(cuid())
  userId    String
  email     String
  emailType String
  sentAt    DateTime @default(now())
  openedAt  DateTime?
  clickedAt DateTime?
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([emailType])
  @@index([sentAt])
}

model PurchaseRequest {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  requestedById  String
  requestedBy    User     @relation("PurchaseRequester", fields: [requestedById], references: [id])
  title          String
  justification  String?
  estimatedCost  Decimal? @db.Decimal(12, 2)
  status         String   @default("DRAFT")
  approvedById   String?
  approvedBy     User?    @relation("PurchaseApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  poNumber       String   @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  vendorId       String?
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
  status         String   @default("DRAFT")
  orderDate      DateTime @default(now())
  expectedDate   DateTime?
  receivedDate   DateTime?
  subtotal       Decimal? @db.Decimal(12, 2)
  tax            Decimal? @db.Decimal(12, 2)
  total          Decimal? @db.Decimal(12, 2)
  notes          String?
  createdById    String
  createdBy      User     @relation("POCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?    @relation("POApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  assetsCreated  Boolean   @default(false)
  items          PurchaseOrderItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([poNumber])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  categoryId      String?
  quantity        Int           @default(1)
  receivedQuantity Int          @default(0)
  unitPrice       Decimal?      @db.Decimal(12, 2)
  totalPrice      Decimal?      @db.Decimal(12, 2)
  notes           String?

  @@index([purchaseOrderId])
}

model SlaRule {
  id                String         @id @default(cuid())
  priority          TicketPriority @unique
  responseTimeMin   Int
  resolutionTimeMin Int
  breachPenalty     String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([priority])
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum BackupStorageBackend {
  LOCAL
  S3
  BACKBLAZE
}

model Backup {
  id             String               @id @default(cuid())
  status         BackupStatus         @default(PENDING)
  storageBackend BackupStorageBackend @default(LOCAL)
  filePath       String?
  fileSize       BigInt?
  md5Hash        String?
  errorMessage   String?
  triggeredBy    String?
  notes          String?
  createdAt      DateTime             @default(now())
  completedAt    DateTime?
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
}
